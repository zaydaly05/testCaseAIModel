{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,datasets/**,docs/**,models/**,public/**,testcase_ai/model/data/**,streamlit_app.py}"
    }
  }
}
