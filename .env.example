# Sign in with Atlassian: every user logs in with their own Jira Cloud account.
# Create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/ :
#   Permissions -> Jira API -> add scopes read:jira-work and read:jira-user
#   Authorization -> callback URLs: http://127.0.0.1:8000/api/auth/callback (web app, local),
#   http://localhost:8501 (Streamlit), https://<your-vercel-domain>/api/auth/callback (deployed)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Deployed on Vercel: set ATLASSIAN_REDIRECT_URI to your main domain, so sign-ins started on
# per-deployment URLs (xyz-abc123.vercel.app) are moved there. Locally it can stay unset.
# ATLASSIAN_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
# ATLASSIAN_STREAMLIT_REDIRECT_URI=http://localhost:8501
# Optional: key that encrypts sign-in cookies (default: derived from the client secret)
# SESSION_SECRET=

# Optional: custom field that holds acceptance criteria, e.g. customfield_10035
JIRA_ACCEPTANCE_CRITERIA_FIELD=
# Optional: what "Pull all stories from Jira" fetches. Default: every issue of type Story.
# JIRA_PROJECT_KEY limits it to one project; JIRA_DEFAULT_JQL replaces the query completely.
JIRA_PROJECT_KEY=
JIRA_DEFAULT_JQL=

# Optional: where the trained model, feedback and extra datasets are stored (default ./models)
# TESTCASE_MODEL_DIR=./models

# Optional, for the DeepEval cross-model review (python -m evals.compare) - never used by the app itself.
# The judge LLM: "provider:model" (groq or gemini), or just set one of the API keys.
# GROQ_API_KEY is free (no card): https://console.groq.com/keys
# EVAL_JUDGE=groq:openai/gpt-oss-120b
# GROQ_API_KEY=
# GEMINI_API_KEY=
